# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nexus:password@localhost:5432/nexus

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o              # deployment name in Azure portal
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# ── Azure Speech Services ────────────────────────────────────────────────────
AZURE_SPEECH_KEY=<your-speech-key>
AZURE_SPEECH_REGION=eastus                 # e.g. eastus, westeurope
AZURE_SPEECH_LANGUAGE=en-US

# ── Azure AD / Entra ID (JWT auth) ───────────────────────────────────────────
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-app-client-id>       # the NEXUS app registration

# ── NEXUS settings ───────────────────────────────────────────────────────────
NEXUS_ENV=development                      # development | production
NEXUS_LOG_LEVEL=INFO
NEXUS_CONTEXT_TOKEN_LIMIT=80000            # rolling window trigger threshold
NEXUS_CONTRIBUTION_TIMEOUT_SECONDS=8      # SLA from system prompt

# ── CORS (tablet origin) ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://nexus.pwc.internal
