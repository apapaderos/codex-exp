{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/routing.json",
  "title": "05-delegation/routing.md",
  "description": "Delegation routing: each (split) action goes to exactly one spec agent.",
  "type": "object",
  "properties": {
    "artifact": {
      "const": "routing"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^x[0-9]+[a-z]?$"
          },
          "from_action": {
            "type": "string",
            "pattern": "^x[0-9]+$"
          },
          "type": {
            "enum": [
              "decision",
              "process",
              "tool"
            ]
          },
          "agent": {
            "enum": [
              "spec-decision",
              "spec-process",
              "spec-tool"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          }
        },
        "required": [
          "item_id",
          "from_action",
          "type",
          "agent",
          "summary",
          "owner",
          "due"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "artifact",
    "items"
  ]
}
