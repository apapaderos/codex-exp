{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/signal-voice.json",
  "title": "01-intake/signal-voice.md",
  "description": "Structured signal from noisy meeting transcripts. Low-confidence claims are kept, never dropped, and weighted less downstream.",
  "type": "object",
  "properties": {
    "artifact": {
      "const": "signal-voice"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "timestamp": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "confidence",
          "timestamp"
        ]
      },
      "minItems": 1
    },
    "uncertain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "heard": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "heard",
          "why"
        ]
      }
    }
  },
  "required": [
    "artifact",
    "speakers",
    "claims",
    "uncertain"
  ]
}
