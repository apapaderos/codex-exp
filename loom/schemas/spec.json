{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/spec.json",
  "title": "05-delegation/<type>/<item>.md",
  "description": "Implementation spec an owner can act on without asking the EC team.",
  "type": "object",
  "properties": {
    "artifact": {
      "const": "spec"
    },
    "type": {
      "enum": [
        "decision",
        "process",
        "tool"
      ]
    },
    "item_id": {
      "type": "string",
      "pattern": "^x[0-9]+[a-z]?$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "definition_of_done": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "due": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    }
  },
  "required": [
    "artifact",
    "type",
    "item_id",
    "owner",
    "definition_of_done",
    "dependencies"
  ]
}
