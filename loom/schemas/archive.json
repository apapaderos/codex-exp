{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/archive.json",
  "title": "archive/<engagement>.md",
  "description": "One closed engagement, searchable by frontmatter. Secondary research reads these first.",
  "type": "object",
  "properties": {
    "artifact": {
      "const": "archive"
    },
    "engagement": {
      "type": "string",
      "minLength": 1
    },
    "client": {
      "type": "string",
      "minLength": 1
    },
    "sector": {
      "type": "string",
      "minLength": 1
    },
    "challenge_type": {
      "type": "string",
      "minLength": 1
    },
    "closed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "landed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "did_not_land": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "follow_up": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "artifact",
    "client",
    "sector",
    "challenge_type",
    "decisions",
    "landed",
    "lessons"
  ]
}
