{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/secondary.json",
  "title": "02-research/round-NN/secondary.md",
  "description": "Secondary research findings for one round. Archive is searched before the web.",
  "type": "object",
  "properties": {
    "artifact": {
      "const": "secondary"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^f[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "from_archive": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "text",
          "source",
          "from_archive"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^g[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "why_it_matters": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    }
  },
  "required": [
    "artifact",
    "round",
    "findings",
    "gaps"
  ]
}
