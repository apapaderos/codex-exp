{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/outcomes.json",
  "title": "04-workshop/capture/outcomes.md",
  "description": "What came out of the room. Every action has a type, owner and due date.",
  "type": "object",
  "properties": {
    "artifact": {
      "const": "outcomes"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^d[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "problem_ref": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^x[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "decision",
              "process",
              "tool"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "problem_ref": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "type",
          "owner",
          "due"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "artifact",
    "sources",
    "decisions",
    "actions"
  ]
}
