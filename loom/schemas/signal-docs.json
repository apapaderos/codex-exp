{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/signal-docs.json",
  "title": "01-intake/signal-docs.md",
  "description": "Structured signal from documents, slides, diagrams and images. Every claim cites a page or region.",
  "type": "object",
  "properties": {
    "artifact": {
      "const": "signal-docs"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "document",
              "slides",
              "diagram",
              "image",
              "spreadsheet",
              "other"
            ]
          }
        },
        "required": [
          "ref",
          "file"
        ]
      },
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "text",
          "source_ref"
        ]
      },
      "minItems": 1
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_ref",
          "description"
        ]
      }
    }
  },
  "required": [
    "artifact",
    "sources",
    "claims",
    "diagrams"
  ]
}
