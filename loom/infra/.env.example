# Copy to infra/.env (git-ignored) or load these into your cloud's secret store.

# Anthropic API key used by the worker for agent runs. Never commit it.
ANTHROPIC_API_KEY=

# sdk = real agents; stub = placeholder artifacts, no API calls (demo / smoke test).
LOOM_RUNNER=sdk

# Basic auth for the web app. Required outside localhost.
LOOM_APP_USER=loom
LOOM_APP_PASSWORD=

# Public URL of the app, used in notification links.
LOOM_APP_BASE_URL=https://loom.example.internal

# Notifications fire on two events only: a gate opening and a wait ending.
# Any endpoint that accepts JSON {"text": "..."}: Teams or Slack incoming webhook, Power Automate, etc.
LOOM_NOTIFY_WEBHOOK=

# Safety limits per agent run.
LOOM_MAX_TURNS=60
LOOM_MAX_BUDGET_USD=5

# Optional model overrides per agent (default comes from the agent's frontmatter):
# LOOM_MODEL_FRAMING=opus
# LOOM_MODEL_ARCHIVIST=haiku

# Reused personal skills (evidence, reframe, solve-for-x, senior-experience-architect) are
# referenced, not copied. Mount a folder containing them and point here, e.g. /srv/skills.
# Without them the agents run and say in their handoff that the skill was unavailable.
LOOM_EXTRA_SKILL_DIRS=

# Run the worker inside the app container instead of a separate service (single-container hosts).
LOOM_INLINE_WORKER=0
